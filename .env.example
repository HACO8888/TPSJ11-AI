# ── App ────────────────────────────────────────────────
NODE_ENV=development
# Public base URL of the deployment (used for absolute OG/social-card image URLs).
# Optional; defaults to http://localhost:3000. On Zeabur set it to your domain.
APP_URL=http://localhost:3000

# ── Database (remote Postgres over public IP) ──────────
# NOTE: this server currently has SSL disabled → sslmode=disable is required.
# Hardening path: once the DB operator enables TLS, switch to ?sslmode=require
# and ssl:'require' in db/index.ts.
DATABASE_URL=postgresql://user:password@host:5432/tpsj11?sslmode=disable

# ── AI Gateway (server-side only — never prefix with NEXT_PUBLIC_) ──
# Base URL WITHOUT the /chat/completions suffix. Every call, images included, goes
# through /chat/completions. Use the gateway's own models, not the openrouter/ ones.
AI_API_BASE_URL=https://ai.onc.tw/v1
AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_TEXT_MODEL=gemini-3.8-flash
AI_IMAGE_MODEL=gemini-3.1-flash-image

# Text+image "mixed" replies: an image turn also streams a short caption alongside the
# image. Set to "off" to fall back to the classic image-only reply. Default: on.
MIXED_OUTPUT=on

# Strategy A (experimental): try a single native text+image call to the image model via
# /chat/completions before the classic two-step. Leave "off" until scripts/probe-
# interleaved.ts confirms the gateway returns images there; failures fall back safely.
AI_NATIVE_INTERLEAVE=off

# ── Session ────────────────────────────────────────────
# Generate with: openssl rand -base64 48   (min 32 chars)
SESSION_SECRET=change-me-min-32-chars-random-string
